# ============================================================================
# Enterprise RFP & Security Questionnaire Auto-Responder - Environment Config
# Copy this file to .env and fill in your credentials (never commit .env)
# ============================================================================

# 1. Server & Deployment Configuration
PORT=8010
CORS_ORIGINS=http://localhost:3000
HITL_DECISIONS_FILE=logs/hitl_decisions.jsonl

# 2. Primary LLM Provider (Choose one: Gemini 2.5 Flash, Groq Llama-3.3-70B, or OpenAI GPT-4o-mini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. Vector Embeddings Provider ("gemini" | "openai" | "deterministic")
EMBEDDING_PROVIDER=deterministic

# 4. n8n Human-in-the-Loop Escalation Webhook (Optional)
N8N_HITL_WEBHOOK_URL=http://localhost:5678/webhook/rfp-hitl-escalation
